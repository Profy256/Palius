# Palius browser worker.
#
# Runs Chromium, so it needs a host with real memory — 2GB minimum per the SRS.
# Not deployable to Vercel functions or a Render `starter` instance.

PORT="8090"

# Shared secret required on every private endpoint. The Go API sends it as
# `Authorization: Bearer <token>` and must be given the SAME value as
# PLAYWRIGHT_WORKER_TOKEN. Unset means the private API is open — local only.
WORKER_TOKEN=""

# Origins allowed to open the streaming WebSocket, comma separated. These are
# the web app's origins, because the user's browser connects here directly.
# Unset allows any origin, which is fine locally and wrong in production.
ALLOWED_ORIGINS="http://localhost:3000"

# ---------- Session behaviour ----------
# How long an unfinished login may stay open before Chromium reclaims it.
WORKER_SESSION_TTL_MS="900000"
# Concurrent logins. Each one is a Chromium context: budget ~150-250MB apiece.
WORKER_MAX_SESSIONS="8"
# JPEG quality of streamed frames. Lower is cheaper; 60-75 is readable.
WORKER_FRAME_QUALITY="70"

# ---------- Browser presentation ----------
# Sent to the platform's login page. Leave unset for a current Chrome UA.
WORKER_USER_AGENT=""
WORKER_LOCALE="en-US"
WORKER_TIMEZONE="UTC"
# Set to "false" to watch a real window while debugging locally.
WORKER_HEADLESS="true"
