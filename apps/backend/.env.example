# Palius backend configuration.
#
# Pick a provider with AI_PROVIDER (default "auto" = first key that is set):
#   AI_PROVIDER=auto | openai | anthropic | gemini | deepseek | openrouter | ollama

# ---------- OpenAI (and any OpenAI-compatible endpoint) ----------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Point at any OpenAI-compatible gateway (Azure, OpenRouter-style, local, etc.):
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# ---------- Google Gemini ----------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---------- DeepSeek (OpenAI-compatible) ----------
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# ---------- OpenRouter (many models) ----------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ---------- Ollama (local, OpenAI-compatible) ----------
OLLAMA_MODEL="llama3.1"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Server
PORT="8080"

# ---------- Admin panel access ----------
# Guards every /api/v1/admin/* endpoint: customer data, spend, plan changes,
# refunds and exports. There is nowhere to "get" this value — you invent it,
# and it is only a password because nobody else knows it:
#
#   openssl rand -base64 32
#
# Paste the same value into the admin panel when it asks (it is stored in your
# browser, never in the app bundle).
#
# Unset means: allowed in development, REFUSED in production. Never deploy
# without it — the admin API would otherwise be open to anyone who finds the URL.
ADMIN_TOKEN=""

# Comma-separated origins allowed to call this API from a browser. Unset means
# allow-all, which is fine locally and unacceptable in production.
# ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Set to "production" to enforce the two rules above.
APP_ENV="development"

# Usage ledger (admin panel)
# SQLite database file used to store users, quotas and usage events.
PALIUS_DB="palius.db"

# ---------- Credential encryption ----------
# AES-256-GCM key material for every stored credential, including captured
# browser sessions. Without it the server REFUSES to store credentials rather
# than writing them in plaintext, and Level 3 login is offered as unavailable.
#   openssl rand -base64 48
PALIUS_SECRET_KEY=""

# ---------- Level 3: browser login (apps/worker) ----------
# Where the API reaches the Playwright worker. Unset means browser login is
# offered as unavailable — nothing silently degrades.
PLAYWRIGHT_WORKER_URL="http://localhost:8090"

# Shared secret for the worker's private API. Must match WORKER_TOKEN there.
PLAYWRIGHT_WORKER_TOKEN=""

# Where the USER'S BROWSER reaches the worker for the frame stream. Only needed
# when that differs from PLAYWRIGHT_WORKER_URL — i.e. whenever the API talks to
# the worker over an internal hostname (docker compose, Render private
# networking) that means nothing in a browser.
PLAYWRIGHT_WORKER_PUBLIC_URL=""
