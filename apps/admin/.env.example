# Palius Admin
# Base URL of the Palius Go + Gin backend (default http://localhost:8080/api/v1).
NEXT_PUBLIC_PALIUS_API="http://localhost:8080/api/v1"

# Workspace/user id sent with requests, for usage attribution. This is a plain
# identifier, NOT a credential — the backend does not verify it, so it grants
# nothing on its own. You do not obtain it from anywhere; it is just the id of
# the account whose usage the panel attributes calls to.
NEXT_PUBLIC_PALIUS_USER_ID="user-1"

# NOTE: the admin token is deliberately NOT configured here.
#
# Every NEXT_PUBLIC_* value is inlined into the JavaScript that ships to the
# browser, so putting ADMIN_TOKEN in this file would publish the master key to
# anyone who can load the page. Instead the panel prompts for it on first use
# and keeps it in that browser's localStorage.
#
# Set the token itself on the BACKEND, as ADMIN_TOKEN.
