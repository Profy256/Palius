# Optional: AI provider keys for the backend service.
# Copy this file to .env and fill in at least one provider, then run:
#   docker compose up -d --build
# Without keys the backend runs in demo/fallback mode (no real AI calls).

# AI_PROVIDER=auto | openai | anthropic | gemini | deepseek | openrouter | ollama
AI_PROVIDER=auto

# ---------- OpenAI / OpenAI-compatible ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------- Google Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- DeepSeek (OpenAI-compatible) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- OpenRouter (many models) ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ---------- Ollama (local, OpenAI-compatible) ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1
